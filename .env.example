# Modèle de .env pour une instance — bots/instances/<nom>/.env
# (tes vrais .env sont déjà inclus et remplis ; ceci sert juste de référence)

DISCORD_TOKEN=          # token du bot Discord (requis)
BOT_ACCESS_ID=          # id d'accès interne pour le dashboard
GUILD_ID=               # id du serveur principal (optionnel)
OWNER_ID=               # ton id Discord (owner .env — bypass total, ex: +mute libre)
PORT=3000               # port du dashboard de cette instance

DISCORD_CLIENT_ID=      # OAuth2 (dashboard login)
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=   # ex: http://localhost:3000/api/auth/callback

JWT_SECRET=             # secret aléatoire pour les sessions dashboard
DASHBOARD_URL=          # ex: http://localhost:5173
SPEED_PHRASE=           # phrase admin (optionnel)
TENOR_API_KEY=          # clé Tenor pour +gif (optionnel)
